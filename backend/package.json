{
  "name": "ride-zilla-backend",
  "version": "1.0.0",
  "description": "Ride Zilla - Advanced Ride Booking Platform Backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate": "node src/database/migrations.js",
    "seed": "node src/database/seeders.js",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": ["ride-booking", "uber", "rapido", "ola", "ride-zilla"],
  "author": "Ride Zilla",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.1",
    "pg": "^8.10.0",
    "razorpay": "^2.8.4",
    "redis": "^4.6.5",
    "socket.io": "^4.6.1",
    "stripe": "^12.1.1",
    "uuid": "^9.0.0",
    "validator": "^13.9.0",
    "winston": "^3.8.2",
    "axios": "^1.4.0",
    "haversine": "^1.1.1"
  },
  "devDependencies": {
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
